{
  "name": "rainnote-h5-ui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "npm run build:mobile && npm run build:pc",
    "build:mobile": "vite build --mode mobile --outDir dist/web-mobile",
    "build:pc": "vite build --mode pc --outDir dist/web-pc && node scripts/fix-pc-index.mjs",
    "preview": "vite preview --host 0.0.0.0"
  },
  "dependencies": {
    "@vitejs/plugin-vue": "latest",
    "axios": "latest",
    "element-plus": "^2.12.0",
    "pinia": "latest",
    "vant": "^4.9.23",
    "vite": "latest",
    "vue": "^3.5.0",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {}
}
