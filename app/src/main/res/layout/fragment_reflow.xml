<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_rainnote_root"
    android:orientation="vertical"
    android:padding="12dp"
    tools:context=".ui.reflow.ReflowFragment">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_paper"
        android:orientation="vertical"
        android:padding="14dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="同步中心"
            android:textColor="@color/rn_text"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/text_reflow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:maxLines="6"
            android:textColor="@color/rn_text_muted"
            android:textSize="14sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:background="@drawable/bg_card"
        android:orientation="vertical"
        android:padding="12dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="1. 发现设备并发送"
            android:textColor="@color/rn_text"
            android:textStyle="bold" />

        <Button
            android:id="@+id/button_discover_wifi"
            style="@style/RainNoteButtonPrimary"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:layout_marginTop="8dp"
            android:text="扫描附近 Wi‑Fi 直连设备" />

        <Button
            android:id="@+id/button_disconnect_wifi"
            style="@style/RainNoteButtonSoft"
            android:layout_width="match_parent"
            android:layout_height="38dp"
            android:layout_marginTop="8dp"
            android:text="断开当前连接" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="10dp"
        android:layout_weight="1"
        android:background="@drawable/bg_paper"
        android:padding="10dp">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerview_wifi_peers"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <TextView
            android:id="@+id/text_peer_empty"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:padding="16dp"
            android:text="还没有发现设备\n点击上方按钮开始扫描"
            android:textColor="@color/rn_text_muted"
            android:textSize="15sp" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:background="@drawable/bg_card"
        android:orientation="vertical"
        android:padding="12dp">

        <TextView
            android:id="@+id/text_pending_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="2. 确认接收"
            android:textColor="@color/rn_text"
            android:textStyle="bold" />

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="130dp"
            android:layout_marginTop="8dp">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recyclerview_pending_notes"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

            <TextView
                android:id="@+id/text_pending_empty"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:text="暂无待接收内容\n收到备份或对方数据后会显示在这里"
                android:textColor="@color/rn_text_muted" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/button_select_all_pending"
                style="@style/RainNoteButtonSoft"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1"
                android:text="全选" />

            <Button
                android:id="@+id/button_clear_pending"
                style="@style/RainNoteButtonSoft"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:text="清空选择" />
        </LinearLayout>

        <Button
            android:id="@+id/button_accept_pending"
            style="@style/RainNoteButtonPrimary"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:layout_marginTop="8dp"
            android:text="接收选中的便签" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/button_export_backup"
            style="@style/RainNoteButtonSoft"
            android:layout_width="0dp"
            android:layout_height="38dp"
            android:layout_weight="1"
            android:text="导出备份" />

        <Button
            android:id="@+id/button_import_backup"
            style="@style/RainNoteButtonSoft"
            android:layout_width="0dp"
            android:layout_height="38dp"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:text="导入备份" />
    </LinearLayout>
</LinearLayout>
