<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="6dp"
    android:layout_marginBottom="8dp"
    android:background="@drawable/bg_card"
    android:orientation="vertical"
    android:padding="10dp">

    <EditText
        android:id="@+id/edit_card_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@android:color/transparent"
        android:hint="卡片标题"
        android:inputType="textCapSentences"
        android:minHeight="34dp"
        android:singleLine="true"
        android:textColor="@color/rn_text"
        android:textColorHint="@color/rn_text_muted"
        android:textSize="16sp"
        android:textStyle="bold"
        tools:text="灵感" />

    <LinearLayout
        android:id="@+id/block_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical" />

    <Button
        android:id="@+id/button_add_row"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end"
        android:background="@drawable/bg_button_soft"
        android:minHeight="32dp"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:text="添加一行"
        android:textAllCaps="false"
        android:textColor="@color/rn_primary_dark"
        android:textSize="12sp" />
</LinearLayout>
