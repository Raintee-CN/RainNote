<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="6dp"
    android:layout_marginBottom="8dp"
    android:background="@drawable/bg_paper"
    android:elevation="1dp"
    android:orientation="vertical"
    android:padding="10dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <EditText
            android:id="@+id/edit_card_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@android:color/transparent"
            android:hint="卡片标题"
            android:inputType="textCapSentences"
            android:minHeight="34dp"
            android:singleLine="true"
            android:textColor="@color/rn_text"
            android:textColorHint="@color/rn_text_muted"
            android:textSize="16sp"
            android:textStyle="bold"
            tools:text="灵感" />

        <TextView
            android:id="@+id/text_drag_handle"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:gravity="center"
            android:text="↕"
            android:textColor="@color/rn_text_muted"
            android:textSize="16sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/block_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical" />

    <Button
        android:id="@+id/button_add_row"
        style="@style/RainNoteButtonTiny"
        android:layout_width="wrap_content"
        android:layout_height="32dp"
        android:layout_gravity="end"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:text="添加一行" />
</LinearLayout>
