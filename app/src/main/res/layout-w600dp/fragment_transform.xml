<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_rainnote_root"
    android:orientation="horizontal"
    android:padding="10dp"
    tools:context=".ui.transform.TransformFragment">

    <LinearLayout
        android:id="@+id/note_list_panel"
        android:layout_width="280dp"
        android:layout_height="match_parent"
        android:background="@drawable/bg_card"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:paddingStart="14dp"
                android:text="我的卡片"
                android:textAppearance="?attr/textAppearanceHeadline6"
                android:textColor="@color/rn_text" />

            <Button
                android:id="@+id/button_add_note"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_margin="8dp"
                android:background="@drawable/bg_button_primary"
                android:minHeight="36dp"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:text="新建卡片"
                android:textAllCaps="false"
                android:textColor="@color/white" />
        </LinearLayout>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerview_transform"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp"
            android:layout_marginBottom="8dp"
            android:layout_weight="1" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/editor_panel"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_marginStart="10dp"
        android:layout_weight="1"
        android:background="@drawable/bg_card"
        android:orientation="vertical"
        android:padding="12dp">

        <Button
            android:id="@+id/button_back_to_list"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="返回卡片列表"
            android:visibility="gone" />

        <EditText
            android:id="@+id/edit_note_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="卡片标题"
            android:inputType="textCapSentences"
            android:singleLine="true"
            android:textColor="@color/rn_text"
            android:textColorHint="@color/rn_text_muted"
            android:textSize="20sp" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerview_blocks"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:paddingTop="8dp"
            android:paddingBottom="8dp" />

        <Button
            android:id="@+id/button_add_block"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_button_primary"
            android:minHeight="38dp"
            android:text="添加一行"
            android:textAllCaps="false"
            android:textColor="@color/white" />

        <Button
            android:id="@+id/button_delete_note"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_button_danger"
            android:minHeight="38dp"
            android:text="删除当前卡片"
            android:textAllCaps="false"
            android:textColor="@color/rn_danger" />
    </LinearLayout>
</LinearLayout>
