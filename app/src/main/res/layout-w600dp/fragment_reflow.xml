<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_rainnote_root"
    android:orientation="vertical"
    android:padding="16dp"
    tools:context=".ui.reflow.ReflowFragment">

    <TextView
        android:id="@+id/text_reflow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_paper"
        android:maxLines="7"
        android:padding="14dp"
        android:scrollbars="vertical"
        android:textColor="@color/rn_text"
        android:textSize="14sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="12dp"
        android:layout_weight="1"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/bg_paper"
            android:orientation="vertical"
            android:padding="10dp">

            <Button
                android:id="@+id/button_discover_wifi"
                style="@style/RainNoteButtonPrimary"
                android:layout_width="match_parent"
                android:layout_height="36dp"
                android:text="发现 Wi‑Fi 直连设备" />

            <Button
                android:id="@+id/button_disconnect_wifi"
                style="@style/RainNoteButtonSoft"
                android:layout_width="match_parent"
                android:layout_height="36dp"
                android:layout_marginTop="8dp"
                android:text="断开 Wi‑Fi 直连" />

            <Button
                android:id="@+id/button_export_backup"
                style="@style/RainNoteButtonSoft"
                android:layout_width="match_parent"
                android:layout_height="36dp"
                android:layout_marginTop="8dp"
                android:text="导出备份" />

            <Button
                android:id="@+id/button_import_backup"
                style="@style/RainNoteButtonSoft"
                android:layout_width="match_parent"
                android:layout_height="36dp"
                android:layout_marginTop="8dp"
                android:text="导入备份" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recyclerview_wifi_peers"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginTop="8dp"
                android:layout_weight="1" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:background="@drawable/bg_paper"
            android:orientation="vertical"
            android:padding="10dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="待接收便签"
                android:textColor="@color/rn_text"
                android:textStyle="bold" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recyclerview_pending_notes"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginTop="8dp"
                android:layout_weight="1" />

            <Button
                android:id="@+id/button_accept_pending"
                style="@style/RainNoteButtonPrimary"
                android:layout_width="match_parent"
                android:layout_height="36dp"
                android:layout_marginTop="8dp"
                android:text="接收选中的便签" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
