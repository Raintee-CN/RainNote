<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_rainnote_root"
    android:fillViewport="true"
    tools:context=".ui.reflow.ReflowFragment">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_paper"
            android:orientation="vertical"
            android:elevation="2dp"
            android:padding="18dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="设备互传"
                android:textColor="@color/rn_text"
                android:textSize="26sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/text_reflow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:maxLines="8"
                android:textColor="@color/rn_text_muted"
                android:lineSpacingExtra="2dp"
                android:textSize="14sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_paper"
            android:elevation="2dp"
            android:orientation="vertical"
            android:padding="12dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="1  准备连接并发送"
                android:textColor="@color/rn_text"
                android:textSize="16sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/button_discover_wifi"
                style="@style/RainNoteButtonPrimary"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:layout_marginTop="8dp"
                android:text="扫描附近 Wi‑Fi 直连设备" />

            <Button
                android:id="@+id/button_disconnect_wifi"
                style="@style/RainNoteButtonSoft"
                android:layout_width="match_parent"
                android:layout_height="38dp"
                android:layout_marginTop="8dp"
                android:text="断开当前连接" />
        </LinearLayout>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="260dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_paper"
            android:padding="10dp">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recyclerview_wifi_peers"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:nestedScrollingEnabled="true"
                android:overScrollMode="ifContentScrolls" />

            <TextView
                android:id="@+id/text_peer_empty"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:padding="16dp"
                android:text="附近设备会显示在这里\n点击扫描按钮开始搜索"
                android:textColor="@color/rn_text_muted"
                android:textSize="15sp" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_paper"
            android:elevation="2dp"
            android:orientation="vertical"
            android:padding="12dp">

            <TextView
                android:id="@+id/text_pending_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="2  确认接收"
                android:textColor="@color/rn_text"
                android:textSize="16sp"
                android:textStyle="bold" />

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="170dp"
                android:layout_marginTop="8dp">

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/recyclerview_pending_notes"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:nestedScrollingEnabled="true"
                    android:overScrollMode="ifContentScrolls" />

                <TextView
                    android:id="@+id/text_pending_empty"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:text="暂无待接收内容\n收到备份或对方数据后会显示在这里"
                    android:textColor="@color/rn_text_muted" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/button_select_all_pending"
                    style="@style/RainNoteButtonSoft"
                    android:layout_width="0dp"
                    android:layout_height="36dp"
                    android:layout_weight="1"
                    android:text="全选" />

                <Button
                    android:id="@+id/button_clear_pending"
                    style="@style/RainNoteButtonSoft"
                    android:layout_width="0dp"
                    android:layout_height="36dp"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:text="清空选择" />
            </LinearLayout>

            <Button
                android:id="@+id/button_accept_pending"
                style="@style/RainNoteButtonPrimary"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:layout_marginTop="8dp"
                android:text="接收选中的卡片集" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/button_export_backup"
                style="@style/RainNoteButtonSoft"
                android:layout_width="0dp"
                android:layout_height="38dp"
                android:layout_weight="1"
                android:text="导出备份" />

            <Button
                android:id="@+id/button_import_backup"
                style="@style/RainNoteButtonSoft"
                android:layout_width="0dp"
                android:layout_height="38dp"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:text="导入备份" />
        </LinearLayout>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
